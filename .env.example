OPENROUTER_API_KEY=sk-or-...
DATABASE_URL=postgres://orchat:orchat@localhost:5432/orchat
BASE_URL=http://localhost:5174
# Microsoft Entra ID (OIDC)
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_SECRET=change-me-to-a-random-string-of-32-plus-chars
OIDC_SCOPES=openid profile email offline_access
# 公開 URL (リバプロ / vite dev 配下では必須)
OIDC_AUTH_EXTERNAL_URL=http://localhost:5174
OIDC_REDIRECT_URI=http://localhost:5174/callback
# optional
MODELS=
ADMIN_EMAILS=
# dev only: skip OIDC and log in as this email (ignored when NODE_ENV=production)
DEV_USER=
# dev only: mock IdP instead of Entra → docker compose --profile dev up -d mock-oidc, then
#   OIDC_ISSUER=https://localhost:18443/entra  OIDC_CLIENT_ID=orchat  OIDC_CLIENT_SECRET=mock-secret  DEV_USER=
