OPENROUTER_API_KEY=sk-or-...
DATABASE_URL=postgres://orchat:orchat@localhost:5432/orchat
BASE_URL=http://localhost:5173
# Microsoft Entra ID (OIDC)
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_SECRET=change-me-to-a-random-string-of-32-plus-chars
OIDC_SCOPES=openid profile email offline_access
# optional
MODELS=
ADMIN_EMAILS=
# dev only: skip OIDC and log in as this email (ignored when NODE_ENV=production)
DEV_USER=
