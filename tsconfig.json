{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "paths": { "@/*": ["./src/client/*"] }
  },
  "include": ["src/client", "src/shared"]
}
